rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "paswanmantu92@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isOwner(uid);

      match /testHistory/{historyId} {
        allow read, write: if isOwner(uid);
      }

      match /stats/{statsId} {
        allow read, write: if isOwner(uid);
      }

      match /devices/{deviceId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.app == "bpsc_teacher_practice"
          && request.resource.data.platform == "android"
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0;
        allow delete: if isOwner(uid);
      }
    }

    // Collection-group read for the trusted worker's Admin SDK is not governed
    // by these rules; this allows the verified admin dashboard to inspect devices.
    match /{path=**}/devices/{deviceId} {
      allow read: if isAdmin();
    }

    match /notificationQueue/{notificationId} {
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.category in ["announcement", "exam", "tre", "questions", "materials", "general"]
        && request.resource.data.target in ["all", "selected"]
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() <= 500
        && (request.resource.data.target == "all" || request.resource.data.userIds.size() > 0);

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /adminNotificationHistory/{notificationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
